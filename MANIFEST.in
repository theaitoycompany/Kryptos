include LICENSE NOTICE README.md pyproject.toml uv.lock
include SECURITY.md CONTRIBUTING.md CHANGELOG.md
include package.json package-lock.json playwright.config.js
recursive-include src *.py *.json *.txt
recursive-include tests *.py *.js
recursive-include benchmarks *.py
recursive-include scripts *.py
recursive-include docs *.md *.json
recursive-include examples *.txt *.json
recursive-include web *.html *.css *.js
global-exclude *.pyc
